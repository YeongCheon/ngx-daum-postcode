{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "ngx-daum-postcode": {
      "projectType": "library",
      "root": "projects/ngx-daum-postcode",
      "sourceRoot": "projects/ngx-daum-postcode/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/ngx-daum-postcode/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ngx-daum-postcode/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ngx-daum-postcode/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/ngx-daum-postcode/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "browsers": "ChromeHeadless"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/ngx-daum-postcode/**/*.ts",
              "projects/ngx-daum-postcode/**/*.html"
            ]
          }
        }
      }
    },
    "example": {
      "projectType": "application",
      "root": "projects/example",
      "sourceRoot": "projects/example/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist/example"
            },
            "index": "projects/example/src/index.html",
            "browser": "projects/example/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/example/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/example/public"
              }
            ],
            "styles": [
              "projects/example/src/styles.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "example:build:production"
            },
            "development": {
              "buildTarget": "example:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "example:build"
          }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/example/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/example/public"
              }
            ],
            "styles": [
              "projects/example/src/styles.css"
            ],
            "scripts": [],
            "browsers": "ChromeHeadless"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/example/**/*.ts",
              "projects/example/**/*.html"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  },
  "schematics": {
    "@schematics/angular:component": {
      "style": "scss",
      "changeDetection": "OnPush"
    },
    "@schematics/angular:library": {
      "strict": true
    }
  }
}
